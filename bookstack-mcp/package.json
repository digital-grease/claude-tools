{
  "name": "bookstack-mcp",
  "version": "4.0.0",
  "description": "MCP server for BookStack wiki — search, read, create, and manage documentation via AI assistants",
  "type": "module",
  "bin": {
    "bookstack-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --packages=external",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "bookstack",
    "model-context-protocol",
    "ai",
    "wiki",
    "documentation",
    "claude",
    "librechat"
  ],
  "author": "ttpears",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttpears/bookstack-mcp.git"
  },
  "homepage": "https://github.com/ttpears/bookstack-mcp#readme",
  "bugs": {
    "url": "https://github.com/ttpears/bookstack-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
